# Set these values in Netlify -> Environment variables, for Builds and Functions.
# Never commit real connection strings or paste them into a chat.
# DATABASE_URL: PostgreSQL connection (prefer a pooled connection for Functions).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Optional: a direct, unpooled connection for migrations and content initialization.
# If omitted, the deployment uses DATABASE_URL for both operations.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Production initializes schema/content automatically. Previews do not migrate by default.
# Set this only on previews with their OWN isolated database if initialization is wanted.
# CUENTICO_INITIALIZE_DATABASE="true"
